# How to tell input-cjk works, on a computer nami made (tests/usb.sh runs these).
"typing Chinese, Japanese and Korean: IBus lists their engines":
  run: ibus-daemon --daemonize --replace --panel=disable --cache=none 2>/dev/null; for i in $(seq 30); do ibus list-engine >/dev/null 2>&1 && break; sleep 1; done; ibus list-engine | grep -oE '^ +(libpinyin|mozc-jp|hangul) ' | sort -u | wc -l | sed 's/^/ENGINES=/'; ibus exit >/dev/null 2>&1
  expect: "^ENGINES=3$"
