# Flatpak, with Flathub: the thousands of apps their makers put there
# (commercial ones too: Spotify, Zoom, Slack...), each in a sandbox of
# its own. Each person's are their own, as the rest of their user.nami is:
# `- flathub:com.spotify.Client` under their packages, or Install on one
# from Flathub in Your Apps (Settings). nami installs it with `flatpak
# --user` into ~/.local/share/flatpak (no admin's password, and nobody
# else gets it), takes off what's taken off the list, and keeps each change
# in their history (`nami history`, `nami undo`).
#
# What's set up here, for that:
# - Flatpak itself; its helper for installs for the whole computer (by
#   hand: `flatpak install --system`) with polkit's rules for admins, and
#   the user `flatpak` it runs as (its sysusers.d).
# - Flathub, for those installs too (remotes.d); nami adds it for each
#   person from the same file.
# - The portals sandboxed apps ask for files, links, printing and settings
#   (light or dark, fonts, the cursor): xdg-desktop-portal with GTK's, and
#   niri's GNOME's.
# - Their menu entries and icons in XDG_DATA_DIRS (after the computer's
#   and the person's own: an app from nixpkgs comes first), for the
#   launcher and the dock.
# - Fonts and icons, the cursor's too: nixpkgs' Flatpak shows its apps
#   /run/current-system/sw/share/X11/fonts and share/icons (nami makes the
#   fonts folder when Flatpak is on the computer).
# - GTK 3's look in the sandbox: adw-gtk3 and adw-gtk3-dark from Flathub,
#   with a person's first app (the GTK 4 apps follow light and dark by the
#   portal).
# - Updates: with the rest in Updates (`nami upgrade`), and by themselves
#   once a day (nami-flathub-update.timer, each person's; a step of their
#   history when a version changes).
packages:
  - xdg-desktop-portal
  - xdg-desktop-portal-gtk
services:
  - nami-flathub-update.timer: { per-person: true }
files:
  /etc/flatpak/remotes.d/flathub.flatpakrepo: |
    [Flatpak Repo]
    Title=Flathub
    Url=https://dl.flathub.org/repo/
    Homepage=https://flathub.org/
    Comment=Central repository of Flatpak applications
    Description=Central repository of Flatpak applications
    Icon=https://dl.flathub.org/repo/logo.svg
    
  # (The computer's and the person's own come first: an app installed both
  # ways is the one from nixpkgs.)
  /etc/profile.d/flatpak.sh: |
    case ":$XDG_DATA_DIRS:" in
      *":${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:"*) ;;
      *) XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share" ;;
    esac
    export XDG_DATA_DIRS
  # Installing for the whole computer: an admin at it, without a password
  # (as Flatpak's own rules say; here where polkit reads them).
  /etc/polkit-1/rules.d/30-flatpak.rules: |
    polkit.addRule(function(action, subject) {
      if ((action.id == "org.freedesktop.Flatpak.app-install" || action.id == "org.freedesktop.Flatpak.runtime-install" ||
           action.id == "org.freedesktop.Flatpak.app-uninstall" || action.id == "org.freedesktop.Flatpak.runtime-uninstall" ||
           action.id == "org.freedesktop.Flatpak.modify-repo") &&
          subject.active && subject.local && subject.isInGroup("wheel"))
        return polkit.Result.YES;
      return polkit.Result.NOT_HANDLED;
    });
  /etc/systemd/user/nami-flathub-update.service: |
    [Unit]
    Description=Your apps from Flathub, to their newest
    ConditionUser=!@system
    ConditionPathIsDirectory=%h/.local/share/flatpak/app
    After=network-online.target
    [Service]
    Type=oneshot
    Nice=10
    IOSchedulingClass=idle
    ExecStart=/nix/var/nami/bin/nami upgrade --flathub
  /etc/systemd/user/nami-flathub-update.timer: |
    [Unit]
    Description=Your apps from Flathub, to their newest, once a day
    ConditionUser=!@system
    [Timer]
    OnStartupSec=15min
    OnUnitActiveSec=1d
    RandomizedDelaySec=30min
    [Install]
    WantedBy=timers.target
