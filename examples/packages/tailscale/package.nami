# Tailscale, as on Ubuntu: `- tailscale` in system.nami, then
# `sudo tailscale up` logs in (in the browser). Or it logs in by itself,
# with an auth key, and takes its settings from system.nami, which
# writes them into /etc/tailscale/up.conf:
#
#   packages:
#     - tailscale
#   files:
#     /etc/tailscale/up.conf:
#       set:                             # `tailscale set` (and up) flags
#         hostname: laptop               # its name in the tailnet
#         operator: ada                 # who may run `tailscale` without sudo
#         ssh: true                      # Tailscale SSH
#         accept-routes: true            # other computers' subnets
#         exit-node: 100.101.102.103     # send the internet through that one
#       up:                              # flags only `tailscale up` takes
#         login-server: https://headscale.example.org
#     # From the admin console's Keys page (root's alone, 0400).
#     /run/nami/secrets/tailscale-auth-key: !secret "YWdl..."
#
# Any `tailscale set` flag goes under set: (`advertise-exit-node: true`,
# `advertise-routes: [192.168.1.0/24]`, `shields-up`, `accept-dns: false`,
# ...); under up:, `login-server` and `advertise-tags`. An exit node or a
# subnet router forwards others' packets: `- tailscale-router`.
#
# The first start, not logged in yet, `tailscale up --auth-key` logs in
# (tailscale-up.service, once tailscaled runs); a bad key fails it, once,
# and `systemctl status tailscale-up` says why. From then on, each start
# and each `nami apply` that changes up.conf, `tailscale set` applies the
# settings, and the login stays as it is. Settings not given here are
# yours to change with `tailscale set`.
#
# MagicDNS names (laptop, laptop.tailnet.ts.net) resolve as on Ubuntu:
# tailscaled tells systemd-resolved, which every nami computer has, about
# them over D-Bus; other names resolve as before. Tailscale's own rules
# (netfilter) are tailscaled's; namiOS's firewall lets the tailnet in
# (tailscale0), and Tailscale's port, for direct connections.
#
# How tailscaled runs: started with the computer, its state (the login) in
# /var/lib/tailscale, kept through updates. nixpkgs' package brings the
# unit (Debian's, as Ubuntu runs it) without the file it reads its port
# from: that's here.
services:
  - tailscaled.service
  - tailscale-up.service
files:
  /etc/firewall/allow.d/tailscale.conf:
    content: |
      [allow]
      Tailscale = udp 41641
    # (Let in from now on, not from the next start.)
    restarts: firewall.service
  # The tunnel device (tailscale0) needs tun.
  /etc/modules-load.d/tailscale.conf: |
    tun
  # NetworkManager leaves tailscale0 to tailscaled: it would take the
  # DNS settings tailscaled gives systemd-resolved for it.
  /etc/NetworkManager/conf.d/tailscale.conf: |
    [keyfile]
    unmanaged-devices=interface-name:tailscale0
  # The settings: none here. system.nami's up.conf is its content,
  # and tailscale-up runs again when `nami apply` changes it.
  /etc/tailscale/up.conf:
    content: {}
    restarts: tailscale-up.service
  /etc/tailscale/up.sh: |
    # tailscale-up.service: the settings in /etc/tailscale/up.conf.
    # Not logged in yet, with an auth key: `tailscale up` logs in with
    # it. Logged in: `tailscale set` applies them, and the login stays
    # as it is.
    set -f
    conf=${1:-/etc/tailscale/up.conf}
    key=${2:-/run/nami/secrets/tailscale-auth-key}
    # The flags in section [$1] of the settings: `name = value` is
    # --name=value (a name given more than once: its values, joined by commas).
    flags() {
      awk -v want="[$1]" '
        /^\[/ { on = ($0 == want); next }
        on && / = / {
          i = index($0, " = "); k = substr($0, 1, i - 1); v = substr($0, i + 3)
          if (k in f) f[k] = f[k] "," v; else { f[k] = v; order[++n] = k }
        }
        END { for (i = 1; i <= n; i++) print "--" order[i] "=" f[order[i]] }' "$conf"
    }
    # Logged in or not (tailscaled can take a moment to know).
    for _ in $(seq 30); do
      state=$(tailscale status --json --peers=false 2>/dev/null | sed -n 's/^ *"BackendState": "\(.*\)",$/\1/p')
      [ -n "$state" ] && [ "$state" != NoState ] && break
      sleep 1
    done
    if [ "$state" = NeedsLogin ] && [ -e "$key" ]; then
      echo "logging in with the auth key"
      exec tailscale up --reset --auth-key="file:$key" --timeout=2m $(flags up) $(flags set)
    fi
    [ "$state" = NeedsLogin ] && echo "not logged in yet: \`sudo tailscale up\` logs in (in the browser)"
    echo "applying the settings (logged in: $state)"
    set -- $(flags set)
    [ $# -gt 0 ] || { echo "(there are none)"; exit 0; }
    exec tailscale set "$@"
  /etc/systemd/system/tailscale-up.service: |
    [Unit]
    Description=Tailscale: logging in with the auth key, and its settings
    Requires=tailscaled.service
    After=tailscaled.service network-online.target
    Wants=network-online.target
    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/run/current-system/sw/bin/sh /etc/tailscale/up.sh
    [Install]
    WantedBy=multi-user.target
  /etc/systemd/system/tailscaled.service.d/nami.conf: |
    [Service]
    # Its port for WireGuard (41641, as on Ubuntu), and no more flags.
    Environment=PORT=41641 FLAGS=
