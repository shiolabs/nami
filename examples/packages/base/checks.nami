# How to tell base works, on a computer nami made (tests/usb.sh runs these).
"the command-line tools an Ubuntu install has":
  run: m=; for c in zip bc wget lsof strace killall vi gpg python3 perl locale ldd traceroute mtr nc dig host nft; do command -v $c >/dev/null || m="$m $c"; done; echo "MISSING:$m."
  expect: "^MISSING:\\.$"
"programs built for other distributions find their loader (/lib64)":
  run: /lib64/ld-linux-x86-64.so.2 --version | head -1
  expect: "ld\\.so|GLIBC|GNU C"
"every language's locale, for Settings' language list (locale -a)":
  run: locale -a | grep -c utf8 | sed 's/^/N=/'
  expect: "N=[1-9][0-9][0-9]"
"every language's locale, for systemd too (localectl list-locales)":
  run: localectl list-locales | grep -ciE 'utf-?8' | sed 's/^/N=/'
  expect: "N=[1-9][0-9][0-9]"
"people join their groups (sound, for everyone)":
  run: getent group audio
  expect: "^audio:x:[0-9]+:[a-z_]"
"next to Windows: NTFS and the firmware's boot menu":
  run: command -v ntfsresize ntfs-3g.probe efibootmgr | wc -l | sed 's/^/N=/'
  expect: "N=3"
"the whole computer in one file (/etc/nami/computer.flat.nami)":
  run: f=/etc/nami/computer.flat.nami; head -1 $f | grep -q '^# Generated by nami' && grep -q "$(hostname)" $f && echo FLAT-OK
  expect: "^FLAT-OK$"
"updates by themselves (daily)":
  run: systemctl is-enabled nami-update.timer
  expect: "^enabled"
"the processor's microcode, in the boot archive":
  run: grep -aoE 'kernel/x86/microcode/[A-Za-z]+.bin' /run/booted-system/initrd | sort -u
  expect: "GenuineIntel.bin"
"everyone's own user IDs for containers, as you (rootless podman)":
  run: cat /etc/subuid /etc/subgid | grep -c ':65536$' | sed 's/^/N=/'
  expect: "N=[1-9]"
