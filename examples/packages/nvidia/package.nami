# NVIDIA's own driver, as Ubuntu's "Additional Drivers" puts it on: the
# desktop (niri, on Wayland) draws with the card, and CUDA and nvidia-smi
# work. `- nvidia` (next to namios) in system.nami. A computer without
# an NVIDIA card starts as before: nothing here loads without one.
#
# The driver is NVIDIA's 595, for cards from Turing on (GTX 16xx, RTX 20xx
# and newer, Quadro T and RTX A), with NVIDIA's open kernel modules,
# which NVIDIA and Ubuntu use for those cards. Older ones (Maxwell, Pascal
# and Volta: GTX 750 to GTX 1080 Ti) take nvidia-legacy instead; `nami
# doctor` says which of the two a computer's card is for.
#
# Its libraries aren't free software, so the binary cache doesn't have
# them: nami builds them once from NVIDIA's download (a few minutes).
#
# Secure Boot stays on: the kernel (nixpkgs') doesn't check modules'
# signatures (MODULE_SIG off) and has no lockdown (SECURITY_LOCKDOWN_LSM
# off), so NVIDIA's modules load unsigned; shim and systemd-boot check
# only the kernel, which is signed with the computer's key.
# The kernel modules (nvidia, nvidia_modeset, nvidia_drm, nvidia_uvm),
# built for the system's kernel, linuxPackages: the version of each
# must match. They join the kernel's own in /lib/modules.
drivers:
  # The card's own processor runs this (GSP), which the open modules need.
  firmware: [linuxPackages.nvidia_x11.firmware]
  # OpenGL, EGL, Vulkan, GBM and VDPAU, next to mesa's in
  # /run/opengl-driver; and EGL's ways onto Wayland, GBM and X11 (NVIDIA's
  # EGL finds them in /etc/egl).
  graphics: [linuxPackages.nvidia_x11.out, egl-wayland, egl-wayland2, egl-gbm, egl-x11]
  # Their 32-bit builds, for 32-bit programs (most of Steam's games):
  # part of the same driver, so nothing more is built.
  graphics-32bit: [linuxPackages.nvidia_x11.lib32]
  kernel-modules: [linuxPackages.nvidia_x11_stable_open]
packages:
  # nvidia-smi, nvidia-bug-report.sh, and CUDA's MPS.
  - linuxPackages.nvidia_x11.bin
files:
  /etc/modprobe.d/nvidia.conf: |
    # nouveau (and nova, after it) would take the card first.
    blacklist nouveau
    blacklist nova_core
    blacklist nvidiafb
    # The desktop draws through the kernel (KMS), as Wayland needs; the
    # text console too (fbdev).
    options nvidia_drm modeset=1 fbdev=1
    # What's on the screen survives suspend: the kernel tells the
    # driver (595 and the open modules do it without systemd services),
    # and the card's memory is saved on the disk, not in RAM.
    options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_UseKernelSuspendNotifiers=1 NVreg_TemporaryFilePath=/var/tmp
  /etc/udev/rules.d/60-nvidia.rules: |
    # udev loads nvidia for an NVIDIA card (by its PCI id); once it's
    # in, the rest: the display (nvidia_drm, with nvidia_modeset) and
    # CUDA's memory (nvidia_uvm). Without a card, nvidia doesn't load,
    # and neither do these.
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia", RUN{builtin}+="kmod load nvidia_modeset nvidia_drm nvidia_uvm"
    # The device files the driver's libraries open (on Ubuntu,
    # nvidia-modprobe makes them).
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; mknod -m 666 /dev/nvidiactl c 195 255; for i in $$(cat /proc/driver/nvidia/gpus/*/information | grep Minor | cut -d \  -f 4); do mknod -m 666 /dev/nvidia$${i} c 195 $${i}; done'"
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia_modeset", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; mknod -m 666 /dev/nvidia-modeset c 195 254'"
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia_uvm", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; d=$$(grep nvidia-uvm /proc/devices | cut -d \  -f 1); mknod -m 666 /dev/nvidia-uvm c $$d 0; mknod -m 666 /dev/nvidia-uvm-tools c $$d 1'"
  # With an NVIDIA card, the login screen waits for udev to have loaded
  # its driver (a few seconds), so it starts on the card and not on the
  # firmware's screen, which nvidia_drm then takes away.
  /etc/systemd/system/gdm.service.d/nvidia.conf: |
    [Service]
    ExecStartPre=-/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; if grep -qsx 0x10de /sys/bus/pci/devices/*/vendor; then udevadm settle -t 15; fi'
