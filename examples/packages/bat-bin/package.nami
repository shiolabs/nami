# A prebuilt vendor binary (the pattern for unfree apps like VS Code or Chrome):
# autoPatchelfHook rewrites its ELF interpreter and RPATH to nixpkgs libraries.
name: bat-bin
version: 0.24.0
source:
  url: https://github.com/sharkdp/bat/releases/download/v0.24.0/bat-v0.24.0-x86_64-unknown-linux-gnu.tar.gz
  sha256: 0faf5d51b85bf81b92495dc93bf687d5c904adc9818b16f61ec2e7a4f925c77a
build-deps: [autoPatchelfHook]
deps: [libgcc.lib]    # libgcc_s.so.1
install: |
  install -Dm755 bat $out/bin/bat
  install -Dm644 bat.1 $out/share/man/man1/bat.1
