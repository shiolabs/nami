# NVIDIA's driver for older cards: Maxwell, Pascal and Volta (GTX 750 to
# GTX 1080 Ti, Quadro M and P, Titan V), which the nvidia example's driver
# no longer has. `- nvidia-legacy` in system.nami, in place of nvidia;
# `nami doctor` says which of the two a computer's card is for. Cards from
# Turing on (GTX 16xx, RTX 20xx and newer) take nvidia.
#
# The driver is NVIDIA's 535, the long-lived branch, with NVIDIA's own
# (closed) kernel modules: the open ones are for Turing on only. Its
# libraries and modules aren't free software, so the binary cache doesn't
# have them: nami builds them once from NVIDIA's download (a few minutes).
# Its modules are built for nixpkgs' default kernel (linuxPackages), so
# this goes without a kernel-* add-on.
#
# Secure Boot stays on: the kernel (nixpkgs') doesn't check modules'
# signatures, so NVIDIA's modules load unsigned.
drivers:
  # OpenGL, EGL, Vulkan, GBM and VDPAU, next to mesa's in
  # /run/opengl-driver, and EGL's ways onto Wayland and GBM.
  graphics: [linuxPackages.nvidia_x11_legacy535.out, egl-wayland, egl-gbm]
  # The 32-bit ones, for 32-bit programs (most of Steam's games).
  graphics-32bit: [linuxPackages.nvidia_x11_legacy535.lib32]
  # The kernel modules (nvidia, nvidia_modeset, nvidia_drm, nvidia_uvm),
  # built for the system's kernel.
  kernel-modules: [linuxPackages.nvidia_x11_legacy535_modules]
packages:
  # nvidia-smi, nvidia-bug-report.sh, and CUDA's MPS.
  - linuxPackages.nvidia_x11_legacy535.bin
  # fgconsole and chvt, which suspending with the card uses.
  - kbd
services:
  - nvidia-suspend.service
  - nvidia-hibernate.service
  - nvidia-resume.service
files:
  /etc/modprobe.d/nvidia.conf: |
    # nouveau (and nova, after it) would take the card first.
    blacklist nouveau
    blacklist nova_core
    blacklist nvidiafb
    # The desktop draws through the kernel (KMS), as Wayland needs.
    options nvidia_drm modeset=1
    # What's on the screen survives suspend: the card's memory is saved on
    # the disk, not in RAM (the services below tell the driver when).
    options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
  /etc/udev/rules.d/60-nvidia.rules: |
    # udev loads nvidia for an NVIDIA card (by its PCI id); once it's
    # in, the rest: the display (nvidia_drm, with nvidia_modeset) and
    # CUDA's memory (nvidia_uvm). Without a card, nvidia doesn't load,
    # and neither do these.
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia", RUN{builtin}+="kmod load nvidia_modeset nvidia_drm nvidia_uvm"
    # The device files the driver's libraries open.
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; mknod -m 666 /dev/nvidiactl c 195 255; for i in $$(cat /proc/driver/nvidia/gpus/*/information | grep Minor | cut -d \  -f 4); do mknod -m 666 /dev/nvidia$${i} c 195 $${i}; done'"
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia_modeset", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; mknod -m 666 /dev/nvidia-modeset c 195 254'"
    ACTION=="add", SUBSYSTEM=="module", KERNEL=="nvidia_uvm", RUN+="/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; d=$$(grep nvidia-uvm /proc/devices | cut -d \  -f 1); mknod -m 666 /dev/nvidia-uvm c $$d 0; mknod -m 666 /dev/nvidia-uvm-tools c $$d 1'"
  # Suspend and hibernate: the 535 driver is told by these (newer ones by
  # the kernel itself), as NVIDIA's own nvidia-*.service files do.
  /etc/systemd/system/nvidia-suspend.service: |
    [Unit]
    Description=NVIDIA system suspend actions
    Before=systemd-suspend.service
    [Service]
    Type=oneshot
    Environment=PATH=/run/current-system/sw/bin
    ExecStart=/run/opengl-driver/bin/nvidia-sleep.sh suspend
    [Install]
    RequiredBy=systemd-suspend.service
  /etc/systemd/system/nvidia-hibernate.service: |
    [Unit]
    Description=NVIDIA system hibernate actions
    Before=systemd-hibernate.service
    [Service]
    Type=oneshot
    Environment=PATH=/run/current-system/sw/bin
    ExecStart=/run/opengl-driver/bin/nvidia-sleep.sh hibernate
    [Install]
    RequiredBy=systemd-hibernate.service
  /etc/systemd/system/nvidia-resume.service: |
    [Unit]
    Description=NVIDIA system resume actions
    After=systemd-suspend.service systemd-hibernate.service
    [Service]
    Type=oneshot
    Environment=PATH=/run/current-system/sw/bin
    ExecStart=/run/opengl-driver/bin/nvidia-sleep.sh resume
    [Install]
    RequiredBy=systemd-suspend.service systemd-hibernate.service
  # With an NVIDIA card, the login screen waits for udev to have loaded
  # its driver (a few seconds), so it starts on the card and not on the
  # firmware's screen, which nvidia_drm then takes away.
  /etc/systemd/system/gdm.service.d/nvidia.conf: |
    [Service]
    ExecStartPre=-/run/current-system/sw/bin/sh -c 'PATH=/run/current-system/sw/bin; if grep -qsx 0x10de /sys/bus/pci/devices/*/vendor; then udevadm settle -t 15; fi'
